// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  googleId  String?  @unique
  password  String?
  avatar    String?
  email     String   @unique
  name      String?
  username  String?  @unique
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events      Event[]
  tasks       Task[]
  moods       MoodLog[]
  sleep       SleepLog?
  behavior    BehaviorSummary?
  preferences Preferences?

  actions   AITools[]
  conflicts Conflict[]
}

model Event {
  id        String   @id @default(uuid())
  title     String
  location  String?
  desc      String?  @map("description") // Mapping 'desc' to 'description'
  startTime DateTime
  endTime   DateTime

  // Storing recurrence as an array of integers [0, 1, 2...] 
  recurringDays Int[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  color     String
  colorName String
  textColor String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Conflict tracking
  conflictTasks ConflictTask[]

  @@index([userId, startTime])
  @@index([userId, endTime])
}

// Represents a detected schedule conflict cluster
model Conflict {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  errorId  String // Human-readable ID like "#ERR-1234"
  summary  String // e.g., "3 Tasks Collision"
  analysis String @db.Text // AI-generated analysis

  status ConflictStatus @default(PENDING)

  // Metadata
  detectedAt DateTime  @default(now())
  resolvedAt DateTime?

  // Relations
  tasks     ConflictTask[]
  proposals ConflictProposal[]

  @@index([userId, status])
  @@index([userId, detectedAt])
}

enum ConflictStatus {
  PENDING // Not yet resolved
  ACCEPTED // User accepted AI proposal
  DECLINED // User declined AI proposal
  AUTO_RESOLVED // System resolved automatically
}

// Represents an event involved in a conflict (snapshot)
model ConflictTask {
  id         String   @id @default(uuid())
  conflictId String
  conflict   Conflict @relation(fields: [conflictId], references: [id], onDelete: Cascade)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Snapshot of event at time of conflict detection
  title     String
  startTime DateTime
  endTime   DateTime

  // Display properties
  displayStart Int // HHMM format
  displayEnd   Int // HHMM format

  // Layout properties (minutes from cluster start)
  relativeStart Int
  relativeEnd   Int

  taskType TaskType @default(CONFLICT)
  priority Priority @default(NORMAL)

  @@index([conflictId])
  @@index([eventId])
}

enum TaskType {
  STATIC // First event in cluster (typically kept in place)
  CONFLICT // Overlapping event that needs rescheduling
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Represents AI-proposed resolution for a conflict
model ConflictProposal {
  id         String   @id @default(uuid())
  conflictId String
  conflict   Conflict @relation(fields: [conflictId], references: [id], onDelete: Cascade)

  eventId String // Which event this proposal is for
  title   String

  // Proposed times
  proposedStart DateTime
  proposedEnd   DateTime

  // Display properties
  displayStart Int // HHMM format
  displayEnd   Int // HHMM format

  // Layout properties (minutes from cluster start)
  relativeStart Int
  relativeEnd   Int

  taskType  TaskType
  reasoning String   @db.Text // AI explanation

  @@index([conflictId])
}

model Task {
  id          String  @id @default(uuid())
  userId      String
  title       String
  description String?
  completed   Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
}

model MoodLog {
  id        String   @id @default(uuid())
  userId    String
  mood      String // productive | tired | stressed | low
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model SleepLog {
  id        String @id @default(uuid())
  userId    String @unique
  sleepTime String // "23:00"
  wakeTime  String // "07:00"

  user User @relation(fields: [userId], references: [id])
}

model BehaviorSummary {
  id        String   @id @default(uuid())
  userId    String   @unique
  summary   Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Preferences {
  id         String @id @default(uuid())
  timezone   String @default("UTC")
  dateFormat String @default("MM/DD/YYYY")

  // Relation back to User
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique
}

model AITools {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  toolType   String // e.g., "IMAGE_GEN", "TEXT_SUMMARIZER", "CODE_FIXER"
  inputData  Json // Stores what the user sent
  outputData Json // Stores the AI response
  createdAt  DateTime @default(now())
}
