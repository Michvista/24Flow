{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "Node",
		"outDir": "dist",
		"rootDir": "./",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": false,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": false,
		"allowSyntheticDefaultImports": true,
		"ignoreDeprecations": "6.0"
	},
	"include": [
		"**/*.ts",
		"**/*.js",
		"prisma.config.mjs",
		"db.mjs",
		"utils/jwt.mjs",
		"passport-config.js"
	],
	"exclude": ["node_modules", "dist"]
}
